# Copy to .env and point hosts at your machine. All model URLs are env-driven
# so you can swap PCs / models without code changes.

# Elasticsearch
ELASTICSEARCH_URL=https://127.0.0.1:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=false

ES_RAW_INDEX=raw_docs_ingest
ES_VALIDATED_INDEX=validated_docs_ingest
ES_PROCESSED_INDEX=processed_docs_ingest
ES_TAXONOMY_INDEX=taxonomy_ingest
ES_THREAT_LIBRARY_INDEX=threat_library_ingest

# Qwen (OpenAI-compatible vLLM) — example: vllm-qwen35 on :8002
VLLM_BASE_URL=http://192.168.18.9:8002
VLLM_UTIL_BASE_URL=http://192.168.18.9:8002
VLLM_API_KEY=
UTIL_MODEL=qwen3.5-9b
TAGGING_MODEL=qwen3.5-9b
QUICK_ACTIONS_MODEL=qwen3.5-9b

# Embeddings — example: vllm-bge-m3 on :8004 (bge-m3 ≈ 1024 dims)
VLLM_EMBED_BASE_URL=http://192.168.18.9:8004
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMS=1024
EMBEDDING_BATCH_SIZE=16
MAX_TOKENS_PER_CHUNK=1500
TEXT_SPLITTER_OVERLAP_RATIO=0.15

# OCR — Docling Serve (example: nexus-docling on :5001)
DOCLING_SERVE_URL=http://192.168.18.9:5001
DOCLING_ENABLE_OCR=true
DOCLING_DOCUMENT_TIMEOUT=1800
USE_NANONETS=false
